# ====================== DATABASE ======================
MONGO_URL=mongodb://localhost:27017/lab-billiard
# Hoặc MongoDB Atlas:
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/lab-billiard

# ====================== AUTH ======================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ====================== EMAIL (Transactional) ======================
# Chọn 1 trong 2 cách:

# --- Cách 1: Gmail (cần bật App Password tại myaccount.google.com/apppasswords) ---
EMAIL_SERVICE=gmail
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="Lab Billiard" <your.gmail@gmail.com>

# --- Cách 2: Resend (https://resend.com - free tier: 3000 emails/tháng) ---
# EMAIL_SERVICE=smtp
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USER=resend
# EMAIL_PASS=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Lab Billiard" <noreply@yourdomain.com>

# Để bỏ qua email (dev mode): để trống EMAIL_USER và EMAIL_PASS

# ====================== VNPAY (Sandbox) ======================
VNPAY_TMN_CODE=LABTEST1
VNPAY_HASH_SECRET=VNPAYSANDBOX2024LABTEST
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ====================== CLOUDINARY (Upload ảnh) ======================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ====================== SERVER ======================
PORT=5000
NODE_ENV=development
